# Required to scan private repos and to open pull requests.
GITHUB_TOKEN=ghp_your_token_here

# Required for inefficiency reasoning, severity, and proposed fixes.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
GITHUB_API_BASE=https://api.github.com
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8000
DATA_DIR=./data
MAX_FILE_BYTES=200000
MAX_FILES=200
